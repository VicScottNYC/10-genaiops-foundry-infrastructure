# Azure Developer CLI environment
AZURE_ENV_NAME=your-environment-name
AZURE_LOCATION=your-azure-region
AZURE_RESOURCE_GROUP=your-resource-group

# Microsoft Foundry
AZURE_AI_ACCOUNT_NAME=your-foundry-account-name
AZURE_AI_PROJECT_NAME=your-foundry-project-name

# Deployment identity
AZURE_PRINCIPAL_ID=your-principal-object-id
AZURE_PRINCIPAL_TYPE=User

# Infrastructure features
ENABLE_MONITORING=true
ENABLE_HOSTED_AGENTS=true
